# Shared secret the agent sends as `Authorization: Bearer <secret>`.
WORKER_SECRET=
# Same Telegram bot as the agent, and your numeric chat id (= your user id).
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
# Local port Funnel proxies to.
PORT=8088
# Where pending one-shot jobs are persisted (survives restarts).
JOBS_FILE=./data/jobs.json
# Where the agent's recurring wakeup entries are persisted. Seeded once with a
# morning brief + evening review; after that the list is the agent's to own.
CRONS_FILE=./data/crons.json
# Waking the agent: a scheduled moment runs a real agent turn instead of pushing
# a canned string. Without these, wakes degrade to a plain Telegram message.
AGENT_WAKE_URL=        # https://<your-vercel-app>/eve/v1/wake
AGENT_WAKE_SECRET=     # must match the agent's WAKE_SECRET
# Where lighting runtime state (held theme, hand-overridden bulbs) is persisted.
LIGHTING_STATE_FILE=./data/lighting-state.json
# Local time zone for the agent-editable lighting schedule and wakeup entries.
OWNER_TIMEZONE=America/New_York
# LIFX (optional). If discovery is flaky — e.g. Tailscale on the Pi causes
# "stopped sending due to unbound socket" + high CPU — bind LIFX to your LAN:
LIFX_ADDRESS=          # the Pi's LAN IP, e.g. 192.168.1.50
LIFX_BROADCAST=        # your subnet broadcast, e.g. 192.168.1.255
LIFX_LIGHTS=           # optional: comma-separated bulb IPs to skip broadcast discovery

# --- Camera + parking (wyze-bridge on the LAN; see deploy/) ---
# Base URL of the wyze-bridge web UI — port 5080 on the IDisposable fork,
# e.g. http://127.0.0.1:5080
WYZE_BRIDGE_URL=
# Camera name as the bridge knows it (lowercase, UNDERSCORES for spaces),
# e.g. street_cam. List them at http://<pi>:5080.
PARKING_CAMERA=
# Describe what the model should look at, e.g. "The two curb spots directly in
# front of the house are the ones that matter." Defaults to a generic count.
PARKING_PROMPT=
# Vision model auth — one of the two. Anthropic key is used directly;
# otherwise the Vercel AI Gateway key routes to anthropic/claude-haiku-4.5.
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# Optional model override (direct: claude-haiku-4-5, gateway: anthropic/claude-haiku-4.5)
VISION_MODEL=

# --- Discord ingestion (gateway listener) ---
# Same bot as the agent. Enable "Message Content Intent" in the Developer Portal.
DISCORD_BOT_TOKEN=
# The agent's ingest endpoint + shared secret (agent side: DISCORD_INGEST_SECRET).
AGENT_DISCORD_URL=      # https://<your-vercel-app>/eve/v1/discord/ingest
DISCORD_AGENT_SECRET=
# Optional: only watch these channel ids (comma-separated). Empty = all channels.
DISCORD_WATCH_CHANNELS=
# How often buffered messages are forwarded to the agent (default 60s).
DISCORD_BATCH_SECONDS=

# --- Presence (phone on home WiFi) ---
PRESENCE_MAC=          # your phone's MAC on the home network (use a non-random MAC)
PRESENCE_INTERFACE=    # optional: limit to one interface, e.g. eth0 or wlan0
PRESENCE_AWAY_GRACE_SECONDS=300   # wait + confirm (ping) before declaring you away
# Notify the agent on arrival/departure so it records your home/away status:
AGENT_PRESENCE_URL=    # https://<your-vercel-app>/eve/v1/presence
PRESENCE_AGENT_SECRET= # must match the agent's PRESENCE_SECRET
